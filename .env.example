# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Optional protected initial bot admin: ONE Discord user ID (Developer Mode > Copy User ID).
# Has access in every server they join. Command promotions are server-specific.
# Empty preserves Discord Manage Server access without a configured initial admin.
ADMIN_ID=

# INFO includes routing, decisions and failures; DEBUG adds bounded diagnostics.
# View Docker logs with: docker compose logs -f --tail=200 bot
LOG_LEVEL=INFO
# Opt-in complete local AI/user traces, separate from console logs.
# Stored under DATA_DIR/debug; secrets are redacted; seven-day / 250 MiB cap.
AI_DEBUG_CAPTURE=off
# Global System One gate; false skips routing and native operator checks.
# true preserves agents.toml [routing].enabled. Restart after changing.
V4_SYSTEM_ONE_ENABLED=true
# Optional TypeSafe Jev routing and operator reviews; existing reviewers work without it.
# Routing uses public context. Reviews may use selected private campaign facts.
# Credentials and account metadata are excluded; oversized reviews use existing reviewers.
TYPESAFE_API_KEY=

# Copy agents.example.toml to the ignored agents.toml for model/provider settings.
# Restart to reload; keep credential values in the ignored .env or environment.
# Optional alternative config file:
# AGENT_CONFIG=/path/to/agents.toml
# Docker Compose mounts that file read-only at /app/agents.toml.
# Credentials are referenced by api_key_env in TOML; never put real keys in TOML.
# OPENAI_API_KEY=
# OLLAMA_API_KEY=

# Legacy LLM defaults below apply only to fields omitted from agents.toml.
LLM_URL=http://127.0.0.1:11434
# Docker Compose uses the host's Ollama by default. Override for a remote server:
# DOCKER_LLM_URL=http://192.168.1.10:11434
# An explicit providers.local.base_url in agents.toml takes precedence.
# digestor: small non-reasoning model, sub-second intent JSON, strong
# Cantonese/zh routing (bench: 9/9 correct on the live sample set)
V4_DIGEST_MODEL=qwen2.5:7b-instruct
# narrator: qwen3.5:35b is ~13x faster than gemma3:27b on GB10 with
# better zh prose — but it's a REASONING model: V4_NARR_THINK=off is
# required (thinking would consume the whole token budget)
V4_NARR_MODEL=qwen3.5:35b
V4_NARR_THINK=off
# Judge–Evaluate–Verify: add one advisory evaluation call per generated
# scene/item. Engine verification always runs. Default off; no retries.
V4_DIRECTOR_EVALUATE=off

# Which channels the engine owns (comma-separated; plain text = table talk)
V4_CHANNEL_IDS=
# Legacy single-channel fallback:
V4_CHANNEL_ID=

# Campaign SQLite database and legacy save import directory
# Docker Compose stores this in the campaign-data volume at /app/data instead.
DATA_DIR=data
