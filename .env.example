# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Model/provider/role settings are centralized in agents.toml (restart to reload).
# Optional alternative config file:
# AGENT_CONFIG=/path/to/agents.toml
# Credentials are referenced by api_key_env in TOML; never put real keys in TOML.
# OPENAI_API_KEY=
# OLLAMA_API_KEY=

# Legacy LLM defaults below apply only to fields omitted from agents.toml.
LLM_URL=http://127.0.0.1:11434
# digestor: small non-reasoning model, sub-second intent JSON, strong
# Cantonese/zh routing (bench: 9/9 correct on the live sample set)
V4_DIGEST_MODEL=qwen2.5:7b-instruct
# narrator: qwen3.5:35b is ~13x faster than gemma3:27b on GB10 with
# better zh prose — but it's a REASONING model: V4_NARR_THINK=off is
# required (thinking would consume the whole token budget)
V4_NARR_MODEL=qwen3.5:35b
V4_NARR_THINK=off
# Judge–Evaluate–Verify: add one advisory evaluation call per generated
# scene/item. Engine verification always runs. Default off; no retries.
V4_DIRECTOR_EVALUATE=off

# Which channels the engine owns (comma-separated; plain text = table talk)
V4_CHANNEL_IDS=
# Legacy single-channel fallback:
V4_CHANNEL_ID=

# Campaign SQLite database and legacy save import directory
DATA_DIR=data
